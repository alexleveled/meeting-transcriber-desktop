{
  "name": "meeting-transcriber",
  "version": "0.6.2",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "build:electron:shell": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outdir=electron/dist",
    "dev:electron": "npm run build:electron:shell && concurrently -k \"next dev --turbopack\" \"wait-on http://127.0.0.1:3000 && node scripts/run-electron.mjs\"",
    "build:electron": "node scripts/package-electron.mjs",
    "fetch-whisper": "node scripts/fetch-whisper.mjs",
    "generate-icon": "node scripts/generate-icon.mjs",
    "dist": "npm run fetch-whisper && npm run generate-icon && npm run build:electron:shell && npm run build:electron && electron-builder --win nsis && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-install.ps1",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
